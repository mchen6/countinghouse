{
  "name": "countinghouse",
  "version": "3.1.2",
  "description": "Multi-tenant runtime and monetization/marketplace backend for MCP tools",
  "bin": {
    "countinghouse": "./bin/countinghouse",
    "cth": "./bin/countinghouse"
  },
  "main": "./bin/framework.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "./bin/countinghouse",
    "start-allow-discover": "NODE_PATH=./lib node ./framework.js --allowDiscover",
    "start-heap-dump": "NODE_PATH=./lib node --expose-gc ./framework.js --heapDump",
    "build": "webpack && chmod +x build/countinghouse",
    "test": "mocha ./test/test1.js && mocha ./test/test2.js && mocha ./test/test3.js && mocha ./test/test4.js && mocha --exit ./test/test5.js && mocha ./test/auth/*.js ./test/device-config/*.js && mocha ./test/test8.js && mocha ./test/test6.js && mocha ./test/test7.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mchen6/countinghouse.git"
  },
  "keywords": [
    "mcp",
    "agent",
    "tools",
    "metering",
    "marketplace",
    "multi-tenant",
    "runtime"
  ],
  "author": "Miaobo Chen",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "async": "^3.2.6",
    "body-parser-xml": "^2.0.5",
    "bson": "^4.0.1",
    "bullmq": "^6.0.9",
    "bunyan": "^1.8.1",
    "cors": "^2.8.1",
    "express": "^4.22.2",
    "express-ws": "^5.0.2",
    "ioredis": "^5.11.1",
    "json-pointer": "^0.6.0",
    "json-schema-ref-parser": "^1.4.0",
    "json-stable-stringify": "^1.0.1",
    "json-stringify-safe": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.20",
    "minimist": "^1.2.0",
    "npm-registry-client": "^7.2.1",
    "oauth": "^0.9.14",
    "once": "^1.4.0",
    "postman-request": "^2.88.1-postman.49",
    "redis": "^3.1.2",
    "redis-commands": "^1.6.0",
    "rewire": "^2.5.2",
    "rimraf": "^2.5.4",
    "rolling-rate-limiter": "^0.1.10",
    "semver": "^5.3.0",
    "serve-favicon": "^2.4.3",
    "soap": "^1.6.4",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "string-hash": "^1.1.1",
    "tar": "^7.5.22",
    "uuid-1345": "^0.99.6",
    "ws": "^8.21.3"
  },
  "overrides": {
    "request": "npm:postman-request@^2.88.1-postman.49",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "bench-rest": "^1.2.4",
    "chalk": "^2.4.2",
    "chmod": "^0.2.1",
    "copy-webpack-plugin": "^4.0.1",
    "expose-loader": "^0.7.3",
    "json-schema-faker": "^0.5.0-rc16",
    "mocha": "^11.8.0",
    "socket.io-client": "^4.8.3",
    "string-replace-webpack-plugin": "^0.1.3",
    "supertest": "^7.2.2",
    "webpack": "^4.43.0",
    "webpack-cli": "^3.3.12",
    "webpack-node-externals": "^2.5.0"
  }
}
