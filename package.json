{
  "name": "countinghouse",
  "version": "6.1.0",
  "description": "Multi-tenant runtime and monetization/marketplace backend for MCP tools",
  "bin": {
    "countinghouse": "./bin/countinghouse",
    "cth": "./bin/countinghouse",
    "countinghouse-migrate-spec": "./bin/countinghouse-migrate-spec.js",
    "countinghouse-migrate-module": "./bin/countinghouse-migrate-module.js",
    "countinghouse-validate": "./bin/countinghouse-validate.js"
  },
  "main": "./framework.js",
  "files": [
    "framework.js",
    "bin/",
    "lib/",
    "pre-installed-packages/",
    "spec/schema.json",
    "spec/README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "golden": "mocha ./test/mcp-contract/*.js",
    "start": "./bin/countinghouse",
    "start-allow-discover": "NODE_PATH=./lib node ./framework.js --allowDiscover",
    "start-heap-dump": "NODE_PATH=./lib node --expose-gc ./framework.js --heapDump",
    "build": "webpack && chmod +x build/countinghouse",
    "test": "mocha ./test/test1.js && mocha ./test/test2.js && mocha ./test/test3.js && mocha ./test/test4.js && mocha --exit ./test/test5.js && mocha ./test/auth/*.js ./test/device-config/*.js ./test/module-loading/*.js ./test/spec-format/*.js ./test/mcp-contract/*.js ./test/validation/*.js ./test/module-authoring/*.js && mocha --exit ./test/composition/*.js && mocha ./test/test8.js && npm run test:peer-standalone && mocha ./test/test6.js && mocha ./test/test7.js",
    "test:peer-standalone": "mocha --exit ./test/direct-peer-channels/03-grant-time-auth.js ./test/direct-peer-channels/04-metering.js ./test/direct-peer-channels/05-backpressure.js ./test/direct-peer-channels/06-no-double-billing.js",
    "demo:repo-review": "node ./framework.js --workerThread --bindAddr 127.0.0.1 --mcpToolCallCost 1 --authConfigPath ./examples/repo-review/auth.json --loadModule ./examples/repo-review/repo-scan --loadModule ./examples/repo-review/secret-detect --loadModule ./examples/repo-review/dep-audit --loadModule ./examples/repo-review/repo-review"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mchen6/countinghouse.git"
  },
  "keywords": [
    "mcp",
    "agent",
    "tools",
    "metering",
    "marketplace",
    "multi-tenant",
    "runtime"
  ],
  "author": "Miaobo Chen",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "async": "^3.2.6",
    "body-parser-xml": "^2.0.5",
    "bson": "^4.0.1",
    "bullmq": "^6.0.9",
    "bunyan": "^1.8.1",
    "cors": "^2.8.1",
    "express": "^4.22.2",
    "ioredis": "^5.11.1",
    "json-pointer": "^0.6.0",
    "json-schema-ref-parser": "^1.4.0",
    "json-stringify-safe": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.20",
    "minimist": "^1.2.0",
    "npm-registry-client": "^7.2.1",
    "oauth": "^0.9.14",
    "once": "^1.4.0",
    "postman-request": "^2.88.1-postman.49",
    "redis": "^3.1.2",
    "redis-commands": "^1.6.0",
    "rewire": "^2.5.2",
    "rimraf": "^2.5.4",
    "rolling-rate-limiter": "^0.1.10",
    "semver": "^5.3.0",
    "serve-favicon": "^2.4.3",
    "soap": "^1.6.4",
    "string-hash": "^1.1.1",
    "tar": "^7.5.22",
    "uuid-1345": "^0.99.6"
  },
  "overrides": {
    "request": "npm:postman-request@^2.88.1-postman.49",
    "qs": "^6.15.2",
    "bullmq": {
      "redis": "$redis"
    }
  },
  "devDependencies": {
    "bench-rest": "^1.2.4",
    "chalk": "^2.4.2",
    "chmod": "^0.2.1",
    "copy-webpack-plugin": "^4.0.1",
    "eslint": "^9.39.5",
    "expose-loader": "^0.7.3",
    "json-schema-faker": "^0.5.0-rc16",
    "mocha": "^11.8.0",
    "string-replace-webpack-plugin": "^0.1.3",
    "supertest": "^7.2.2",
    "webpack": "^4.43.0",
    "webpack-cli": "^3.3.12",
    "webpack-node-externals": "^2.5.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
}
