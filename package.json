    "bson": "^4.0.1",
    "bull": "^3.20.0",
    "bunyan": "^1.8.1",
    "chmodr": "^1.0.2",
    "chokidar": "^3.5.0",
    "cors": "^2.8.1",
    "express": "^4.22.2",
    "express-http-proxy": "^1.2.0",
    "express-ws": "^5.0.2",
    "fs-extra": "^10.0.0",
    "isbinaryfile": "^4.0.6",
    "json-pointer": "^0.6.0",
    "json-schema-ref-parser": "^1.4.0",
    "json-stable-stringify": "^1.0.1",
    "json-stringify-safe": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.20",
    "minimist": "^1.2.0",
    "mkdirp": "^0.5.1",
    "morgan": "~1.6.1",
    "nano": "^6.2.0",
    "npm-registry-client": "^7.2.1",
    "oauth": "^0.9.14",
    "oauth2-server": "^3.0.1",
    "once": "^1.4.0",
