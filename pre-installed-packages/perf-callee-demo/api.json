{
  "device": {
    "friendlyName": "perf-callee-demo",
    "manufacturer": "countinghouse",
    "modelDescription": "echoes back a variable-size payload -- benchmark fixture, see docs/direct-peer-channels.md",
    "publishAudit": true,
    "iconList": [
      {
        "mimetype": "image/png",
        "width": 88,
        "height": 88,
        "depth": 8,
        "url": "/images/API.png"
      }
    ],
    "serviceList": {
      "urn:countinghouse-com:serviceID:perfCalleeService": {
        "actionList": [
          {
            "name": "echoPayload",
            "description": "Returns the input data unchanged. Benchmark fixture only, not part of any documented public API.",
            "input": {
              "schema": "/perfCalleeService/echoPayload/input"
            },
            "output": {
              "schema": "/perfCalleeService/echoPayload/output"
            },
            "fault": {
              "schema": "/fault/perfCalleeService/echoPayload/fault"
            }
          }
        ]
      }
    }
  }
}
