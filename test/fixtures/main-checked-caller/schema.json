{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "callerService": {
    "hop": {
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "take",
              "give"
            ]
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "action",
          "args"
        ]
      },
      "output": {
        "type": "object"
      }
    },
    "ping": {
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      }
    }
  }
}
