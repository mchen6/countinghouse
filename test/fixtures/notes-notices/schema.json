{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "notesService": {
    "readNote": {
      "input": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}}, "required": ["id"]},
      "output": {"type": "object", "properties": {"id": {"type": "string"}, "text": {"type": "string"}}, "required": ["id", "text"]}
    },
    "about": {
      "output": {"type": "object", "properties": {"count": {"type": "integer"}}, "required": ["count"]}
    },
    "save": {
      "input": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "text": {"type": "string"}}, "required": ["id", "text"]},
      "output": {"type": "object", "properties": {"saved": {"type": "boolean"}}, "required": ["saved"]}
    },
    "fail": {
      "input": {"type": "object", "properties": {"id": {"type": "string"}}},
      "output": {"type": "object"}
    }
  }
}
