{
  "device": {
    "friendlyName": "asks-questions",
    "manufacturer": "countinghouse-test",
    "modelDescription": "a module whose handler asks its user a declared question (ctx.ask, MCP completeness M13)",
    "serviceList": {
      "urn:countinghouse-test:serviceID:askService": {
        "actionList": [
          {
            "name": "probe",
            "description": "Asks whether to do a thing, and says what came of asking.",
            "input": {
              "schema": "/askService/probe/input"
            },
            "output": {
              "schema": "/askService/probe/output"
            },
            "questions": {
              "confirm": {
                "message": "Do {what}?",
                "schema": "/askService/probe/questions/confirm"
              }
            }
          }
        ]
      }
    }
  }
}
