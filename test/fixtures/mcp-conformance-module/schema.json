{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "shapeService": {
    "object_out": {
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "no_schema_string": {
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "no_schema_object": {
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "no_schema_empty": {
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "prefix_items_out": {
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "pair": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          }
        },
        "required": [
          "pair"
        ]
      }
    },
    "coded_error": {
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "strict_out": {
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "binary_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caption",
          "chart",
          "clips",
          "doc"
        ],
        "properties": {
          "caption": {
            "type": "string"
          },
          "chart": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "image/png",
            "title": "Chart",
            "description": "The rendered chart"
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "string",
              "contentEncoding": "base64",
              "contentMediaType": "audio/wav"
            }
          },
          "doc": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "application/pdf",
            "description": "A report, sent as base64 until M6"
          }
        }
      }
    },
    "many_images_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "imgs": {
            "type": "array",
            "items": {
              "type": "string",
              "contentEncoding": "base64",
              "contentMediaType": "image/png"
            }
          }
        }
      }
    },
    "big_image_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "img": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "image/png"
          }
        }
      }
    },
    "array_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "string_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "string"
      }
    },
    "number_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "number"
      }
    },
    "null_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "null"
      }
    },
    "binary_whole_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "string",
        "contentEncoding": "base64",
        "contentMediaType": "image/png"
      }
    },
    "images_array_out": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "array",
        "items": {
          "type": "string",
          "contentEncoding": "base64",
          "contentMediaType": "image/png"
        }
      }
    }
  }
}
