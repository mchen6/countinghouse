          {"name": "config", "description": "Return the module's device config.", "input": {"schema": "/probeService/config/input"}, "output": {"schema": "/probeService/config/output"}},
          {"name": "where", "description": "Report what the module sees of its own location.", "input": {"schema": "/probeService/where/input"}, "output": {"schema": "/probeService/where/output"}},
