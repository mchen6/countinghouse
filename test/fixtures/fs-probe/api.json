          {"name": "exit", "description": "End the worker.", "input": {"schema": "/probeService/exit/input"}, "output": {"schema": "/probeService/exit/output"}},
          {"name": "fsResults", "description": "Paths the module's fs returns.", "input": {"schema": "/probeService/fsResults/input"}, "output": {"schema": "/probeService/fsResults/output"}}
