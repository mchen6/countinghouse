{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "probeService": {
    "write": {
      "input": {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}, "repeat": {"type": "integer", "minimum": 1, "maximum": 1000000}}, "required": ["path", "content"]},
      "output": {"type": "object", "properties": {"ok": {"type": "boolean"}, "code": {"type": ["string", "null"]}}}
    },
    "read": {
      "input": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]},
      "output": {"type": "object", "properties": {"content": {"type": ["string", "null"]}, "code": {"type": ["string", "null"]}}}
    },
    "config": {
      "input": {"type": "object"},
      "output": {"type": "object", "properties": {"config": {"type": ["object", "null"]}}}
    },
    "where": {
      "input": {"type": "object"},
      "output": {"type": "object", "properties": {"dirname": {"type": "string"}, "filename": {"type": "string"}, "cwd": {"type": "string"}, "tmpdir": {"type": "string"}, "resolve": {"type": "string"}, "dirResolve": {"type": "string"}, "frame": {"type": "string"}, "own": {"type": "string"}}}
    }
  }
}
