{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "boundService": {
    "big": {
      "input": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "bytes"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "patch": {
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "captured": {
            "type": "boolean"
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          },
          "threw": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "writeBig": {
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer"
          }
        }
      }
    },
    "longPath": {
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "refused": {
            "type": "boolean"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "scopes": {
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "atLoad": {
            "type": "boolean"
          },
          "inHandler": {
            "type": "boolean"
          },
          "inReply": {
            "type": "boolean"
          },
          "handles": {
            "type": "integer"
          },
          "hookSaw": {
            "type": "boolean"
          },
          "hookThisIsHook": {
            "type": "boolean"
          },
          "handedOver": {
            "type": "boolean"
          }
        }
      }
    },
    "throwOdd": {
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
