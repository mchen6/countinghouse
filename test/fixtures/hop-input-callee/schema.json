{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "sinkService": {
    "sink": {
      "input": {
        "type": "object",
        "properties": {
          "s": {
            "type": "string"
          }
        },
        "required": [
          "s"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "length": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "length",
          "sha256"
        ]
      }
    },
    "count": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "runs": {
            "type": "integer"
          }
        },
        "required": [
          "runs"
        ]
      }
    },
    "big": {
      "input": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "n"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "s": {
            "type": "string"
          }
        },
        "required": [
          "s"
        ]
      }
    },
    "bad": {
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "length": {
            "type": "integer"
          }
        },
        "required": [
          "length"
        ]
      }
    },
    "slow": {
      "input": {
        "type": "object",
        "properties": {
          "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120000
          }
        },
        "required": [
          "ms"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "waited": {
            "type": "integer"
          }
        },
        "required": [
          "waited"
        ]
      }
    },
    "forge": {
      "input": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "n"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "s": {
            "type": "string"
          }
        },
        "required": [
          "s"
        ]
      }
    }
  }
}
