{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "markService": {
    "busy": {
      "input": {
        "type": "object",
        "properties": {
          "maxMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      }
    }
  }
}
