        "balance"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "countinghouse_usage_report",
    "description": "What this countinghouse has done for you: per tool, server, pack or module, the calls, the server calls made for them, and the lines and bytes read from servers and returned to the model, from this process and earlier ones. Token columns are an estimate (utf8 bytes / 4).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "description": "a day (YYYY-MM-DD), an ISO time, a duration back from now (30m, 24h, 7d), or \"all\" (from the first record); absent: the last 31 days for a plain key, everything recorded for an admin"
        },
        "until": {
          "type": "string",
          "description": "a day (YYYY-MM-DD, through its end), an ISO time, or a duration back from now; absent: now"
        },
        "groupBy": {
          "type": "string",
          "enum": [
            "tool",
            "server",
            "pack",
            "module"
          ],
          "description": "what each row counts: a tool (the default), a server, a pack, or a module"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "window": {
          "type": "object",
          "properties": {
            "since": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32
            },
            "until": {
              "type": "string",
              "maxLength": 32
            },
            "first": {
              "title": "the first record in the window",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32
            },
            "last": {
              "title": "the last record in the window",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32
            }
          },
          "required": [
            "since",
            "until",
            "first",
            "last"
          ],
          "additionalProperties": false
        },
        "groupBy": {
          "type": "string",
          "enum": [
            "tool",
            "server",
            "pack",
            "module"
          ]
        },
        "method": {
          "type": "string",
          "const": "utf8 bytes / 4"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "memory",
              "files",
              "metering"
            ]
          },
          "maxItems": 3
        },
        "groups": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "caller": {
                "title": "the opaque caller id; admin reports only",
                "type": "string",
                "maxLength": 256
              },
              "tool": {
                "type": "string",
                "maxLength": 256
              },
              "server": {
                "type": "string",
                "maxLength": 256
              },
              "pack": {
                "type": "string",
                "maxLength": 256
              },
              "module": {
                "type": "string",
                "maxLength": 256
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "serverCalls": {
                "type": "integer",
                "minimum": 0
              },
              "bytesIn": {
                "type": "integer",
                "minimum": 0
              },
              "linesIn": {
                "type": "integer",
                "minimum": 0
              },
              "bytesOut": {
                "type": "integer",
                "minimum": 0
              },
              "linesOut": {
                "type": "integer",
                "minimum": 0
              },
              "tokensInEst": {
                "title": "an estimate: utf8 bytes / 4",
                "type": "integer",
                "minimum": 0
              },
              "tokensOutEst": {
                "title": "an estimate: utf8 bytes / 4",
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "calls",
              "serverCalls",
              "bytesIn",
              "linesIn",
              "bytesOut",
              "linesOut",
              "tokensInEst",
              "tokensOutEst"
            ],
            "additionalProperties": false
          }
        },
        "groupsOmitted": {
          "title": "groups past the 500 most active, in no row (still in totals)",
          "type": "integer",
          "minimum": 0
        },
        "totals": {
          "title": "the period's totals: the headline",
          "type": "object",
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "serverCalls": {
              "type": "integer",
              "minimum": 0
            },
            "bytesIn": {
              "type": "integer",
              "minimum": 0
            },
            "linesIn": {
              "type": "integer",
              "minimum": 0
            },
            "bytesOut": {
              "type": "integer",
              "minimum": 0
            },
            "linesOut": {
              "type": "integer",
              "minimum": 0
            },
            "tokensInEst": {
              "title": "an estimate: utf8 bytes / 4",
              "type": "integer",
              "minimum": 0
            },
            "tokensOutEst": {
              "title": "an estimate: utf8 bytes / 4",
              "type": "integer",
              "minimum": 0
            },
            "keptOut": {
              "title": "tokens kept out of the model's context: an upper-bound estimate, not a measurement",
              "type": "object",
              "properties": {
                "estimate": {
                  "type": "integer",
                  "minimum": 0
                },
                "method": {
                  "type": "string",
                  "const": "utf8 bytes / 4 of max(0, bytes read from servers - bytes returned), rounded per tool call"
                },
                "bound": {
                  "title": "upper: it takes the model to have read, without the tool, every byte the tool read",
                  "type": "string",
                  "const": "upper"
                }
              },
              "required": [
                "estimate",
                "method",
                "bound"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "calls",
            "serverCalls",
            "bytesIn",
            "linesIn",
            "bytesOut",
            "linesOut",
            "tokensInEst",
            "tokensOutEst",
            "keptOut"
          ],
          "additionalProperties": false
        },
        "days": {
          "title": "one row per UTC day with activity, oldest first; at most the newest 366",
          "type": "array",
          "maxItems": 366,
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\d$",
                "maxLength": 10
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "serverCalls": {
                "type": "integer",
                "minimum": 0
              },
              "bytesIn": {
                "type": "integer",
                "minimum": 0
              },
              "bytesOut": {
                "type": "integer",
                "minimum": 0
              },
              "tokensInEst": {
                "title": "an estimate: utf8 bytes / 4",
                "type": "integer",
                "minimum": 0
              },
              "tokensOutEst": {
                "title": "an estimate: utf8 bytes / 4",
                "type": "integer",
                "minimum": 0
              },
              "keptOut": {
                "title": "tokens kept out of the model's context: an upper-bound estimate, not a measurement",
                "type": "object",
                "properties": {
                  "estimate": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "method": {
                    "type": "string",
                    "const": "utf8 bytes / 4 of max(0, bytes read from servers - bytes returned), rounded per tool call"
                  },
                  "bound": {
                    "title": "upper: it takes the model to have read, without the tool, every byte the tool read",
                    "type": "string",
                    "const": "upper"
                  }
                },
                "required": [
                  "estimate",
                  "method",
                  "bound"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "day",
              "calls",
              "serverCalls",
              "bytesIn",
              "bytesOut",
              "tokensInEst",
              "tokensOutEst",
              "keptOut"
            ],
            "additionalProperties": false
          }
        },
        "daysOmitted": {
          "title": "days with activity before the rows kept (still in totals)",
          "type": "integer",
          "minimum": 0
        },
        "profile": {
          "type": "object",
          "properties": {
            "callMs": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "totalMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "p50": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "p95": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "max": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "count",
                "totalMs",
                "p50",
                "p95",
                "max"
              ],
              "additionalProperties": false
            },
            "serverCallMs": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "totalMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "p50": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "p95": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "max": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "count",
                "totalMs",
                "p50",
                "p95",
                "max"
              ],
              "additionalProperties": false
            },
            "errors": {
              "type": "object",
              "properties": {
                "calls": {
                  "title": "errors by code: the runtime's codes, TOOL_ERROR, a system error's, MODULE_ERROR (a module's own code), NO_CODE, UNRECORDED (an older record), OTHER (anything else, and past the 32 most frequent)",
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                    "maxLength": 64
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxProperties": 33
                },
                "serverCalls": {
                  "title": "errors by code: the runtime's codes, TOOL_ERROR, a system error's, MODULE_ERROR (a module's own code), NO_CODE, UNRECORDED (an older record), OTHER (anything else, and past the 32 most frequent)",
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                    "maxLength": 64
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxProperties": 33
                }
              },
              "required": [
                "calls",
                "serverCalls"
              ],
              "additionalProperties": false
            },
            "serverCallsPerCall": {
              "type": "object",
              "properties": {
                "mean": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "max": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "distribution": {
                  "type": "object",
                  "properties": {
                    "0": {
                      "type": "integer"
                    },
                    "1": {
                      "type": "integer"
                    },
                    "2-4": {
                      "type": "integer"
                    },
                    "5+": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "0",
                    "1",
                    "2-4",
                    "5+"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "mean",
                "max",
                "distribution"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "callMs",
            "serverCallMs",
            "errors",
            "serverCallsPerCall"
          ],
          "additionalProperties": false
        },
        "standIn": {
          "title": "server calls an acceptance stand-in answered (--remoteOriginMap): in no group or total",
          "type": "object",
          "properties": {
            "serverCalls": {
              "type": "integer"
            },
            "bytesIn": {
              "type": "integer"
            },
            "linesIn": {
              "type": "integer"
            },
            "tokensInEst": {
              "type": "integer"
            },
            "servers": {
              "type": "object",
              "propertyNames": {
                "maxLength": 256
              },
              "additionalProperties": {
                "type": "integer"
              },
              "maxProperties": 256
            }
          },
          "required": [
            "serverCalls",
            "bytesIn",
            "linesIn",
            "tokensInEst",
            "servers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "window",
        "groupBy",
        "method",
        "source",
        "groups",
        "groupsOmitted",
        "totals",
        "days",
        "daysOmitted",
        "profile"
      ],
