  "cases": [
    {
      "name": "a PROVE whose ms is wrong",
      "given": "HELLO sent; PROVE arrives with ms = msHex with its first byte xor 0x01",
      "expect": "the shim closes the connection, sends no AUTH and relays no client byte"
    },
    {
      "name": "a frame over its kind's cap",
      "given": "any frame whose length field exceeds the cap (handshake 4096, C 65536, M as WELCOME says)",
      "expect": "the receiver closes without reading the payload"
    },
    {
      "name": "an unknown kind byte",
      "given": "a frame of kind \"Z\"",
      "expect": "the receiver closes the connection"
    },
    {
      "name": "bytes before HELLO",
      "given": "more than 512 bytes from a connection that has sent no complete HELLO",
      "expect": "the runtime closes it"
    },
    {
      "name": "a wrong AUTH",
      "given": "AUTH with mc of another secret",
      "expect": "the runtime sends REFUSED {code: \"BAD_PROOF\"} and closes"
    },
    {
      "name": "a resume while the session is live",
      "given": "AUTH with the resumeToken of a session that still has a connection",
      "expect": "REFUSED {code: \"RESUME_REFUSED\"}; the shim then opens a new session and replays its records"
    },
    {
      "name": "an M frame before WELCOME",
      "given": "an M or C frame from the shim before WELCOME",
      "expect": "the runtime closes the connection"
    },
    {
